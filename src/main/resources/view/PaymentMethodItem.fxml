<?xml version="1.0" encoding="UTF-8"?>

<?import io.github.palexdev.materialfx.controls.MFXButton?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<HBox xmlns:fx="http://javafx.com/fxml/1"
      alignment="CENTER_LEFT"
      spacing="16"
      styleClass="md-list-item"
      xmlns="http://javafx.com/javafx/17.0.12"
      fx:controller="com.presentation.controller.paymentmethod.PaymentMethodItemController">
    <padding>
        <Insets top="12" right="16" bottom="12" left="16"/>
    </padding>

    <!-- Payment Method Information -->
    <VBox spacing="4" HBox.hgrow="ALWAYS">
        <!-- Name + Badges -->
        <HBox spacing="8" alignment="CENTER_LEFT">
            <Label fx:id="paymentMethodName" styleClass="md-list-item-headline"/>
            <VBox fx:id="statusBadge">
                <Label fx:id="statusLabel" styleClass="md-nav-badge"/>
            </VBox>
            <VBox fx:id="modifierBadge">
                <Label fx:id="modifierTypeLabel" styleClass="md-nav-badge"/>
            </VBox>
        </HBox>
        <!-- Details -->
        <HBox spacing="16" alignment="CENTER_LEFT">
            <HBox spacing="4">
                <Label styleClass="md-list-item-supporting-text" text="Descripción:"/>
                <Label fx:id="paymentMethodDescription" styleClass="md-list-item-supporting-text"/>
            </HBox>
            <HBox spacing="4">
                <Label styleClass="md-list-item-supporting-text" text="Modificador:"/>
                <Label fx:id="priceModifierLabel" styleClass="md-list-item-supporting-text"/>
            </HBox>
        </HBox>
    </VBox>

    <!-- Separator vertical antes de acciones -->
    <Separator orientation="VERTICAL" styleClass="md-divider"
               prefHeight="32.0"/>

    <!-- Actions -->
    <HBox spacing="8" alignment="CENTER_RIGHT">
        <MFXButton fx:id="editButton" styleClass="md-button-outlined" text="Editar"/>
        <MFXButton fx:id="toggleStatusButton" styleClass="md-button-tonal" text="Desactivar"/>
    </HBox>
</HBox>
