<?xml version="1.0" encoding="UTF-8"?>

<?import io.github.palexdev.materialfx.controls.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<StackPane xmlns:fx="http://javafx.com/fxml/1"
           fx:id="stackPane"
           xmlns="http://javafx.com/javafx/17.0.12"
           fx:controller="com.presentation.controller.dashboard.DashboardController">

    <BorderPane fx:id="borderPane" prefHeight="720.0" prefWidth="1200.0">

        <!-- ================================================================= -->
        <!-- NAVIGATION DRAWER (BARRA LATERAL CON ICONOGRAFÍA)                -->
        <!-- ================================================================= -->
        <left>
            <VBox styleClass="md-navigation-drawer" spacing="12" prefWidth="260.0">
                <padding>
                    <Insets top="16" right="12" bottom="16" left="12"/>
                </padding>

                <!-- Logo e Identidad -->
                <VBox alignment="CENTER" spacing="8">
                    <ImageView fitHeight="60.0" fitWidth="60.0" pickOnBounds="true" preserveRatio="true">
                        <Image url="@../images/Logo.jpg"/>
                    </ImageView>
                    <VBox alignment="CENTER">
                        <Label styleClass="md-title-medium" text="LA TERCERA"/>
                        <Label styleClass="md-label-small" text="BARBERSHOP"/>
                    </VBox>
                </VBox>

                <Separator styleClass="md-nav-divider"/>

                <!-- Menú de Navegación con Íconos (Doble Código) -->
                <VBox spacing="4" VBox.vgrow="ALWAYS">
                    <MFXButton fx:id="navbarDashboardButton" maxWidth="Infinity"
                               styleClass="md-nav-button, md-nav-button-active" text="Dashboard">
                        <graphic>
                            <Region styleClass="category-icon, md-icon-small, md-icon-primary"/>
                        </graphic>
                    </MFXButton>

                    <MFXButton fx:id="navbarClientButton" maxWidth="Infinity" styleClass="md-nav-button"
                               text="Clientes">
                        <graphic>
                            <Region styleClass="person-1-icon, md-icon-small"/>
                        </graphic>
                    </MFXButton>

                    <MFXButton fx:id="navbarEmployeeButton" maxWidth="Infinity" styleClass="md-nav-button"
                               text="Empleados">
                        <graphic>
                            <Region styleClass="person-apron-icon, md-icon-small"/>
                        </graphic>
                    </MFXButton>

                    <MFXButton fx:id="navbarAppointmentButton" maxWidth="Infinity" styleClass="md-nav-button"
                               text="Turnos">
                        <graphic>
                            <Region styleClass="calendar-today-icon, md-icon-small"/>
                        </graphic>
                    </MFXButton>

                    <MFXButton fx:id="navbarBarberServiceButton" maxWidth="Infinity" styleClass="md-nav-button"
                               text="Servicios">
                        <graphic>
                            <Region styleClass="work-icon, md-icon-small"/>
                        </graphic>
                    </MFXButton>

                    <MFXButton fx:id="navbarProductButton" maxWidth="Infinity" styleClass="md-nav-button"
                               text="Stock de productos">
                        <graphic>
                            <Region styleClass="box-icon, md-icon-small"/>
                        </graphic>
                    </MFXButton>

                    <MFXButton fx:id="navbarPaymentButton" maxWidth="Infinity" styleClass="md-nav-button"
                               text="Medios de pago">
                        <graphic>
                            <Region styleClass="payments-icon, md-icon-small"/>
                        </graphic>
                    </MFXButton>
                </VBox>

                <Separator styleClass="md-nav-divider"/>

                <!-- Sección Inferior -->
                <VBox spacing="4">
                    <MFXButton fx:id="navbarSettingsButton" maxWidth="Infinity" styleClass="md-nav-button"
                               text="Configuración">
                        <graphic>
                            <Region styleClass="enterprise-icon, md-icon-small"/>
                        </graphic>
                    </MFXButton>

                    <MFXButton fx:id="navbarLogoutButton" maxWidth="Infinity" styleClass="md-nav-button"
                               text="Cerrar Sesión">
                        <graphic>
                            <Region styleClass="logout-icon, md-icon-small"/>
                        </graphic>
                    </MFXButton>
                </VBox>
            </VBox>
        </left>

        <!-- ================================================================= -->
        <!-- CONTENIDO PRINCIPAL                                               -->
        <!-- ================================================================= -->
        <center>
            <VBox>
                <!-- Header Superior Funcional -->
                <HBox alignment="CENTER_LEFT">
                    <padding>
                        <Insets top="16" right="24" bottom="16" left="24"/>
                    </padding>
                    <VBox spacing="2">
                        <Label styleClass="md-headline-medium" text="Dashboard"/>
                        <Label styleClass="md-body-medium" text="Resumen del día y accesos directos"/>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                </HBox>

                <!-- Área Escroleable -->
                <ScrollPane fitToHeight="true" fitToWidth="true"
                            style="-fx-background-color: transparent; -fx-background: transparent;" VBox.vgrow="ALWAYS">
                    <VBox spacing="24">
                        <padding>
                            <Insets top="20" right="24" bottom="24" left="24"/>
                        </padding>

                        <!-- 1. TARJETAS DE ESTADÍSTICAS RÁPIDAS -->
                        <GridPane hgap="16" vgap="16">
                            <columnConstraints>
                                <ColumnConstraints hgrow="ALWAYS" percentWidth="25"/>
                                <ColumnConstraints hgrow="ALWAYS" percentWidth="25"/>
                                <ColumnConstraints hgrow="ALWAYS" percentWidth="25"/>
                                <ColumnConstraints hgrow="ALWAYS" percentWidth="25"/>
                            </columnConstraints>

                            <!-- Tarjeta 1: Clientes Registrados -->
                            <VBox styleClass="md-card" spacing="8" GridPane.columnIndex="0">
                                <padding>
                                    <Insets top="16" right="16" bottom="16" left="16"/>
                                </padding>
                                <HBox alignment="CENTER_LEFT">
                                    <Label styleClass="md-label-large" text="Clientes nuevos"/>
                                    <!-- Espaciador flexible que empuja el ícono a la esquina derecha -->
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Region styleClass="groups-2-icon, md-icon-medium, md-icon-primary"/>
                                </HBox>
                                <Label fx:id="newClientsThisMonth" styleClass="md-display-small"/>
                                <HBox spacing="4" alignment="CENTER_LEFT">
                                    <Region styleClass="arrow-up-circle-icon, md-icon-small"/>
                                    <Label fx:id="newClientsPercentageVsLastMonth"
                                           styleClass="md-label-medium"/>
                                    <Label styleClass="md-label-small" text="vs mes anterior"/>
                                </HBox>
                            </VBox>

                            <!-- Tarjeta 2: Porcentaje de ocupacion -->
                            <VBox styleClass="md-card" spacing="8" GridPane.columnIndex="1">
                                <padding>
                                    <Insets top="16" right="16" bottom="16" left="16"/>
                                </padding>
                                <HBox alignment="CENTER_LEFT">
                                    <Label styleClass="md-label-large" text="Ganancias hoy"/>
                                    <!-- Espaciador flexible -->
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Region styleClass="person-apron-icon, md-icon-medium, md-icon-primary"/>
                                </HBox>
                                <Label fx:id="expectedIncome" styleClass="md-display-small"/>
                                <HBox spacing="4" alignment="CENTER_LEFT">
                                    <Label fx:id="averageTicketValue" styleClass="md-label-medium"
                                           text="0"/>
                                    <Label styleClass="md-label-small"/>
                                </HBox>
                            </VBox>

                            <!-- Tarjeta 3: Turnos Hoy -->
                            <VBox styleClass="md-card" spacing="8" GridPane.columnIndex="2">
                                <padding>
                                    <Insets top="16" right="16" bottom="16" left="16"/>
                                </padding>
                                <HBox alignment="CENTER_LEFT">
                                    <Label styleClass="md-label-large" text="Turnos para Hoy"/>
                                    <!-- Espaciador flexible -->
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Region styleClass="calendar-today-icon, md-icon-medium, md-icon-primary"/>
                                </HBox>
                                <Label fx:id="appointmentsTodayCount" styleClass="md-display-small"/>
                                <HBox spacing="4" alignment="CENTER_LEFT">
                                    <Label fx:id="finishedAppointmentsTodayCount" styleClass="md-label-medium"
                                           text="0"/>
                                    <Label styleClass="md-label-small" text="completados"/>
                                </HBox>
                            </VBox>

                            <!-- Tarjeta 4: Productos en Stock -->
                            <VBox styleClass="md-card" spacing="8" GridPane.columnIndex="3">
                                <padding>
                                    <Insets top="16" right="16" bottom="16" left="16"/>
                                </padding>
                                <HBox alignment="CENTER_LEFT">
                                    <Label styleClass="md-label-large" text="Productos en Stock"/>
                                    <!-- Espaciador flexible -->
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Region styleClass="box-icon, md-icon-medium, md-icon-primary"/>
                                </HBox>
                                <Label fx:id="lowStockProductCount" styleClass="md-display-small"/>
                                <HBox spacing="4" alignment="CENTER_LEFT">
                                    <Label fx:id="outOfStockProductCount" styleClass="md-label-medium"/>
                                    <Label styleClass="md-label-small"/>
                                </HBox>
                            </VBox>
                        </GridPane>

                        <!-- 2. ACCESOS RÁPIDOS (Tarjetas estructuradas con jerarquía de botones) -->
                        <VBox spacing="12">
                            <Label styleClass="md-title-medium" text="Accesos Rápidos"/>

                            <GridPane hgap="16" vgap="16">
                                <columnConstraints>
                                    <ColumnConstraints hgrow="ALWAYS" percentWidth="50"/>
                                    <ColumnConstraints hgrow="ALWAYS" percentWidth="50"/>
                                </columnConstraints>

                                <!-- Card: Gestión de Clientes -->
                                <VBox styleClass="md-card" spacing="16" GridPane.columnIndex="0"
                                      GridPane.rowIndex="0">
                                    <padding>
                                        <Insets top="16" right="16" bottom="16" left="16"/>
                                    </padding>
                                    <HBox alignment="CENTER_LEFT">
                                        <VBox spacing="2" HBox.hgrow="ALWAYS">
                                            <Label styleClass="md-title-medium" text="Gestión de Clientes"/>
                                            <Label styleClass="md-body-small"
                                                   text="Administración de altas y padrón de clientes"/>
                                        </VBox>
                                        <Region styleClass="person-1-icon, md-icon-medium"/>
                                    </HBox>
                                    <HBox spacing="8" alignment="CENTER_LEFT">
                                        <MFXButton fx:id="clientsViewButton" styleClass="md-button-outlined"
                                                   text="Ver Clientes"/>
                                        <MFXButton fx:id="createClientButton" styleClass="md-button-tonal"
                                                   text="+ Nuevo Cliente"/>
                                    </HBox>
                                </VBox>

                                <!-- Card: Gestión de Empleados -->
                                <VBox styleClass="md-card" spacing="16" GridPane.columnIndex="1"
                                      GridPane.rowIndex="0">
                                    <padding>
                                        <Insets top="16" right="16" bottom="16" left="16"/>
                                    </padding>
                                    <HBox alignment="CENTER_LEFT">
                                        <VBox spacing="2" HBox.hgrow="ALWAYS">
                                            <Label styleClass="md-title-medium" text="Gestión de Empleados"/>
                                            <Label styleClass="md-body-small"
                                                   text="Control de personal, horarios y comisiones"/>
                                        </VBox>
                                        <Region styleClass="groups-icon, md-icon-medium"/>
                                    </HBox>
                                    <HBox spacing="8" alignment="CENTER_LEFT">
                                        <MFXButton fx:id="employeeViewButton" styleClass="md-button-outlined"
                                                   text="Ver Empleados"/>
                                        <MFXButton fx:id="createEmployeeButton" styleClass="md-button-tonal"
                                                   text="+ Nuevo Empleado"/>
                                    </HBox>
                                </VBox>

                                <!-- Card: Gestión de Turnos -->
                                <VBox styleClass="md-card" spacing="16" GridPane.columnIndex="0"
                                      GridPane.rowIndex="1">
                                    <padding>
                                        <Insets top="16" right="16" bottom="16" left="16"/>
                                    </padding>
                                    <HBox alignment="CENTER_LEFT">
                                        <VBox spacing="2" HBox.hgrow="ALWAYS">
                                            <Label styleClass="md-title-medium" text="Gestión de Turnos"/>
                                            <Label styleClass="md-body-small"
                                                   text="Agenda del día y reservas de la barbería"/>
                                        </VBox>
                                        <Region styleClass="calendar-icon, md-icon-medium"/>
                                    </HBox>
                                    <HBox spacing="8" alignment="CENTER_LEFT">
                                        <MFXButton fx:id="appointmentsViewButton" styleClass="md-button-outlined"
                                                   text="Ver Turnos"/>
                                        <MFXButton fx:id="createAppointmentButton" styleClass="md-button-filled"
                                                   text="+ Nuevo Turno"/>
                                    </HBox>
                                </VBox>

                                <!-- Card: Stock de Productos -->
                                <VBox styleClass="md-card" spacing="16" GridPane.columnIndex="1"
                                      GridPane.rowIndex="1">
                                    <padding>
                                        <Insets top="16" right="16" bottom="16" left="16"/>
                                    </padding>
                                    <HBox alignment="CENTER_LEFT">
                                        <VBox spacing="2" HBox.hgrow="ALWAYS">
                                            <Label styleClass="md-title-medium" text="Stock de Productos"/>
                                            <Label styleClass="md-body-small"
                                                   text="Control de inventario y reposición de insumos"/>
                                        </VBox>
                                        <Region styleClass="inventory-1-icon, md-icon-medium"/>
                                    </HBox>
                                    <HBox spacing="8" alignment="CENTER_LEFT">
                                        <MFXButton fx:id="productsViewButton" styleClass="md-button-outlined"
                                                   text="Ver Inventario"/>
                                        <MFXButton fx:id="createProductButton" styleClass="md-button-tonal"
                                                   text="+ Nuevo Producto"/>
                                    </HBox>
                                </VBox>
                            </GridPane>
                        </VBox>

                        <!-- 3. ACTIVIDAD RECIENTE -->
                        <VBox spacing="12">
                            <Label styleClass="md-title-medium" text="Actividad Reciente"/>
                            <VBox fx:id="activityLogVbox" styleClass="md-card">
                                <padding>
                                    <Insets top="16" right="16" bottom="16" left="16"/>
                                </padding>
                            </VBox>
                        </VBox>

                    </VBox>
                </ScrollPane>
            </VBox>
        </center>
    </BorderPane>
</StackPane>