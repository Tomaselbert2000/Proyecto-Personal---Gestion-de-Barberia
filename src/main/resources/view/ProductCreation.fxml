<?xml version="1.0" encoding="UTF-8"?>

<?import io.github.palexdev.materialfx.controls.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<AnchorPane fx:id="anchorPane"
            xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.presentation.controller.product.ProductCreationController">

    <VBox AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
          AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">

        <!-- ================================================================= -->
        <!-- HEADER SUPERIOR CON BOTÓN VOLVER E ICONO                          -->
        <!-- ================================================================= -->
        <HBox alignment="CENTER_LEFT" spacing="16">
            <padding>
                <Insets top="16" right="24" bottom="16" left="24"/>
            </padding>

            <MFXButton fx:id="backButton" styleClass="md-button-outlined" text="Volver">
                <graphic>
                    <Region styleClass="arrow-up-circle-icon, md-icon-small"/>
                </graphic>
            </MFXButton>

            <VBox spacing="2">
                <Label styleClass="md-headline-medium" text="Nuevo Producto"/>
                <Label styleClass="md-body-medium" text="Carga los datos para dar de alta un producto en el catálogo"/>
            </VBox>
        </HBox>

        <!-- ================================================================= -->
        <!-- ÁREA ESCROLEABLE DE FORMULARIO                                    -->
        <!-- ================================================================= -->
        <ScrollPane fitToHeight="true" fitToWidth="true"
                    style="-fx-background-color: transparent; -fx-background: transparent;"
                    VBox.vgrow="ALWAYS">
            <VBox spacing="24">
                <padding>
                    <Insets top="20" right="24" bottom="24" left="24"/>
                </padding>

                <!-- 1. INFORMACIÓN GENERAL DEL PRODUCTO -->
                <VBox styleClass="md-card" spacing="16">
                    <padding>
                        <Insets top="20" right="20" bottom="20" left="20"/>
                    </padding>

                    <!-- Header de Sección con Ícono -->
                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <Region styleClass="info-icon, md-icon-medium, md-icon-primary"/>
                        <Label styleClass="md-title-medium" text="Información General"/>
                    </HBox>

                    <GridPane hgap="16" vgap="16">
                        <columnConstraints>
                            <ColumnConstraints hgrow="ALWAYS" percentWidth="50"/>
                            <ColumnConstraints hgrow="ALWAYS" percentWidth="50"/>
                        </columnConstraints>

                        <!-- Nombre del Producto -->
                        <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="0">
                            <HBox spacing="4">
                                <Label styleClass="md-label-medium" text="Nombre del Producto"/>
                                <Label styleClass="md-label-medium, md-input-error" text="*"/>
                            </HBox>
                            <TextField fx:id="productName" promptText="Ej. Shampoo Matizador 250ml"
                                       styleClass="md-text-field"
                                       maxWidth="Infinity"/>
                        </VBox>

                        <!-- Categoría -->
                        <VBox spacing="4" GridPane.columnIndex="1" GridPane.rowIndex="0">
                            <HBox spacing="4">
                                <Label styleClass="md-label-medium" text="Categoría"/>
                                <Label styleClass="md-label-medium, md-input-error" text="*"/>
                            </HBox>
                            <ComboBox fx:id="productCategorySelector" promptText="Seleccionar categoría"
                                      styleClass="md-combo-box" maxWidth="Infinity"/>
                        </VBox>

                        <!-- Descripción -->
                        <VBox spacing="4" GridPane.columnIndex="0" GridPane.columnSpan="2" GridPane.rowIndex="1">
                            <Label styleClass="md-label-medium" text="Descripción detallada (Opcional)"/>
                            <TextField fx:id="optionalDescription"
                                       promptText="Detalles sobre el uso, fragancia o componentes..."
                                       styleClass="md-text-field" maxWidth="Infinity"/>
                        </VBox>

                        <!-- Marca -->
                        <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="2">
                            <Label styleClass="md-label-medium" text="Marca / Fabricante"/>
                            <TextField fx:id="brandName" promptText="Ej. L'Oréal, Sir Fausto"
                                       styleClass="md-text-field" maxWidth="Infinity"/>
                        </VBox>

                        <!-- Presentación y Unidad -->
                        <HBox spacing="8" GridPane.columnIndex="1" GridPane.rowIndex="2">
                            <VBox spacing="4" HBox.hgrow="ALWAYS">
                                <Label styleClass="md-label-medium" text="Presentación"/>
                                <TextField fx:id="productPresentationField" promptText="Ej. 250"
                                           styleClass="md-text-field" maxWidth="Infinity"/>
                            </VBox>
                            <VBox spacing="4" prefWidth="120.0">
                                <Label styleClass="md-label-medium" text="Unidad"/>
                                <ComboBox fx:id="presentationUnitComboBox" promptText="ml" styleClass="md-combo-box"
                                          maxWidth="Infinity"/>
                            </VBox>
                        </HBox>
                    </GridPane>
                </VBox>

                <!-- 2. PRECIOS Y COSTOS -->
                <VBox styleClass="md-card" spacing="16">
                    <padding>
                        <Insets top="20" right="20" bottom="20" left="20"/>
                    </padding>

                    <!-- Header de Sección con Ícono -->
                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <Region styleClass="money-bag-icon, md-icon-medium, md-icon-primary"/>
                        <Label styleClass="md-title-medium" text="Precios y Costos"/>
                    </HBox>

                    <GridPane hgap="16" vgap="16">
                        <columnConstraints>
                            <ColumnConstraints hgrow="ALWAYS" percentWidth="33"/>
                            <ColumnConstraints hgrow="ALWAYS" percentWidth="33"/>
                            <ColumnConstraints hgrow="ALWAYS" percentWidth="33"/>
                        </columnConstraints>

                        <!-- Costo de Compra -->
                        <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="0">
                            <HBox spacing="4">
                                <Label styleClass="md-label-medium" text="Costo de Compra ($)"/>
                                <Label styleClass="md-label-medium, md-input-error" text="*"/>
                            </HBox>
                            <TextField fx:id="productCost" promptText="0.00" styleClass="md-text-field"/>
                        </VBox>

                        <!-- Precio de Venta -->
                        <VBox spacing="4" GridPane.columnIndex="1" GridPane.rowIndex="0">
                            <HBox spacing="4">
                                <Label styleClass="md-label-medium" text="Precio de Venta al Público ($)"/>
                                <Label styleClass="md-label-medium, md-input-error" text="*"/>
                            </HBox>
                            <TextField fx:id="currentPrice" promptText="0.00" styleClass="md-text-field"/>
                        </VBox>

                        <!-- Margen de Ganancia (Cálculo Destacado) -->
                        <VBox spacing="4" GridPane.columnIndex="2" GridPane.rowIndex="0">
                            <Label styleClass="md-label-medium" text="Margen de Ganancia Proyectado"/>
                            <HBox alignment="CENTER_LEFT" styleClass="md-card-filled" prefHeight="38.0">
                                <padding>
                                    <Insets left="12" right="12"/>
                                </padding>
                                <Label fx:id="profitMarginValue" styleClass="md-title-medium" text="0%"/>
                            </HBox>
                        </VBox>

                        <!-- Precio Mayoreo -->
                        <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="1">
                            <Label styleClass="md-label-medium" text="Precio de venta por mayor ($)"/>
                            <TextField fx:id="wholesalePrice" promptText="0.00" styleClass="md-text-field"/>
                        </VBox>

                        <!-- Precio Mínimo -->
                        <VBox spacing="4" GridPane.columnIndex="1" GridPane.rowIndex="1">
                            <Label styleClass="md-label-medium" text="Precio de venta mínimo ($)"/>
                            <TextField fx:id="minPrice" promptText="0.00" styleClass="md-text-field"/>
                        </VBox>

                        <!-- Descuento Máximo -->
                        <VBox spacing="4" GridPane.columnIndex="2" GridPane.rowIndex="1">
                            <Label styleClass="md-label-medium" text="Descuento Máximo Permitido (%)"/>
                            <TextField fx:id="maxDiscount" promptText="0%" styleClass="md-text-field"/>
                        </VBox>
                    </GridPane>
                </VBox>

                <!-- 3. INVENTARIO E IMAGEN (FILA COMPARTIDA BALANCEADA) -->
                <GridPane hgap="16" vgap="16">
                    <columnConstraints>
                        <ColumnConstraints hgrow="ALWAYS" percentWidth="50"/>
                        <ColumnConstraints hgrow="ALWAYS" percentWidth="50"/>
                    </columnConstraints>

                    <!-- Tarjeta de Stock e Inventario -->
                    <VBox styleClass="md-card" spacing="16" GridPane.columnIndex="0">
                        <padding>
                            <Insets top="20" right="20" bottom="20" left="20"/>
                        </padding>

                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <Region styleClass="warehouse-icon, md-icon-medium, md-icon-primary"/>
                            <Label styleClass="md-title-medium" text="Stock e Inventario"/>
                        </HBox>

                        <GridPane hgap="16" vgap="16">
                            <columnConstraints>
                                <ColumnConstraints hgrow="ALWAYS" percentWidth="50"/>
                                <ColumnConstraints hgrow="ALWAYS" percentWidth="50"/>
                            </columnConstraints>

                            <!-- Stock Inicial -->
                            <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                <HBox spacing="4">
                                    <Label styleClass="md-label-medium" text="Stock Inicial"/>
                                    <Label styleClass="md-label-medium, md-input-error" text="*"/>
                                </HBox>
                                <TextField fx:id="currentStockLevel" promptText="0" styleClass="md-text-field"/>
                            </VBox>

                            <!-- Stock Mínimo -->
                            <VBox spacing="4" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                <HBox spacing="4">
                                    <Label styleClass="md-label-medium" text="Stock Mínimo (Alerta)"/>
                                    <Label styleClass="md-label-medium, md-input-error" text="*"/>
                                </HBox>
                                <TextField fx:id="safetyStockLevel" promptText="5" styleClass="md-text-field"/>
                            </VBox>
                        </GridPane>
                    </VBox>

                    <!-- Tarjeta de Imagen del Producto -->
                    <VBox styleClass="md-card" spacing="16" GridPane.columnIndex="1">
                        <padding>
                            <Insets top="20" right="20" bottom="20" left="20"/>
                        </padding>

                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <Region styleClass="box-icon, md-icon-medium, md-icon-primary"/>
                            <Label styleClass="md-title-medium" text="Imagen del Producto"/>
                        </HBox>

                        <HBox spacing="16" alignment="CENTER_LEFT">
                            <StackPane styleClass="md-card-filled" prefWidth="90.0" prefHeight="90.0">
                                <ImageView fx:id="productImagePreview" fitHeight="80.0" fitWidth="80.0"
                                           pickOnBounds="true" preserveRatio="true"/>
                            </StackPane>

                            <VBox spacing="8" alignment="CENTER_LEFT">
                                <MFXButton fx:id="selectImageButton" styleClass="md-button-outlined"
                                           text="Seleccionar Imagen"/>
                                <MFXButton fx:id="removeImageButton" styleClass="md-button-text"
                                           text="Eliminar Imagen"/>
                                <Label styleClass="md-body-small" text="Formatos permitidos: JPG, PNG"/>
                            </VBox>
                        </HBox>
                    </VBox>
                </GridPane>

                <!-- 4. BARRA DE ACCIONES PRINCIPAL (GUARDAR / LIMPIAR) -->
                <HBox spacing="12" alignment="CENTER_RIGHT">
                    <MFXButton fx:id="resetFormButton" styleClass="md-button-text" text="Limpiar campos"/>
                    <MFXButton fx:id="saveButton" styleClass="md-button-filled" text="Guardar Producto">
                        <graphic>
                            <Region styleClass="done-all-icon, md-icon-small, md-icon-on-surface"/>
                        </graphic>
                    </MFXButton>
                </HBox>

            </VBox>
        </ScrollPane>
    </VBox>
</AnchorPane>