<?xml version="1.0" encoding="UTF-8"?>

<?import io.github.palexdev.materialfx.controls.MFXButton?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.Circle?>
<HBox xmlns:fx="http://javafx.com/fxml/1"
      alignment="CENTER_LEFT"
      spacing="16"
      styleClass="md-list-item"
      xmlns="http://javafx.com/javafx/25"
      fx:controller="com.presentation.controller.employee.EmployeeItemController">
    <padding>
        <Insets top="12" right="16" bottom="12" left="16"/>
    </padding>

    <!-- Employee Avatar (envuelto en md-card-filled) -->
    <StackPane styleClass="md-card-filled" minWidth="40.0" minHeight="40.0"
               maxWidth="40.0" maxHeight="40.0">
        <padding>
            <Insets top="2" right="2" bottom="2" left="2"/>
        </padding>
        <Circle fx:id="employeeAvatar" radius="18"/>
        <Label fx:id="employeeInitials" styleClass="md-label-large"/>
    </StackPane>

    <!-- Employee Information -->
    <VBox spacing="4" HBox.hgrow="ALWAYS">
        <!-- Name + Status Badge -->
        <HBox spacing="8" alignment="CENTER_LEFT">
            <Label fx:id="employeeName" styleClass="md-list-item-headline"
                   text="Employee Name"/>
            <VBox fx:id="employeeStatusBadge">
                <Label fx:id="statusLabel" styleClass="md-nav-badge"/>
            </VBox>
        </HBox>

        <!-- Details -->
        <HBox spacing="16" alignment="CENTER_LEFT">
            <HBox spacing="4">
                <Label styleClass="md-list-item-supporting-text" text="Contratación:"/>
                <Label fx:id="hireDate" styleClass="md-list-item-supporting-text"/>
            </HBox>
            <HBox spacing="4">
                <Label styleClass="md-list-item-supporting-text" text="Comisión:"/>
                <Label fx:id="commissionPercentage" styleClass="md-list-item-supporting-text"/>
            </HBox>
            <HBox spacing="4">
                <Label styleClass="md-list-item-supporting-text" text="Turnos este mes:"/>
                <Label fx:id="monthlyAppointments" styleClass="md-list-item-supporting-text"/>
            </HBox>
        </HBox>
    </VBox>

    <!-- Separator vertical antes de acciones -->
    <Separator orientation="VERTICAL" styleClass="md-divider"
               prefHeight="32.0"/>

    <!-- Actions -->
    <HBox spacing="8" alignment="CENTER_RIGHT">
        <MFXButton fx:id="editButton" styleClass="md-button-outlined" text="Editar"/>
        <MFXButton fx:id="toggleStatusButton" styleClass="md-button-tonal" text="Desactivar"/>
    </HBox>
</HBox>
