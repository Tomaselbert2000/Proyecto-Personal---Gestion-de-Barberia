<?xml version="1.0" encoding="UTF-8"?>

<?import io.github.palexdev.materialfx.controls.MFXButton?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<AnchorPane xmlns:fx="http://javafx.com/fxml/1"
            fx:id="anchor_pane"
            xmlns="http://javafx.com/javafx/17.0.12"
            fx:controller="com.presentation.controller.product.ProductViewController">

    <VBox
            AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0"
            AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">

        <!-- Header del Panel -->
        <HBox alignment="CENTER_LEFT">
            <padding>
                <Insets top="16" right="24" bottom="16" left="24"/>
            </padding>
            <VBox spacing="2">
                <Label styleClass="md-headline-medium" text="Stock de Productos"/>
                <Label styleClass="md-body-large" text="Administra el inventario de productos"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
        </HBox>

        <!-- Contenido Principal -->
        <ScrollPane fitToHeight="true" fitToWidth="true"
                    style="-fx-background-color: transparent; -fx-background: transparent;"
                    VBox.vgrow="ALWAYS">
            <VBox spacing="24">
                <padding>
                    <Insets top="20" right="24" bottom="24" left="24"/>
                </padding>

                <!-- Tarjetas de Estadísticas de Productos -->
                <GridPane hgap="16" vgap="16">
                    <columnConstraints>
                        <ColumnConstraints hgrow="ALWAYS" percentWidth="25"/>
                        <ColumnConstraints hgrow="ALWAYS" percentWidth="25"/>
                        <ColumnConstraints hgrow="ALWAYS" percentWidth="25"/>
                        <ColumnConstraints hgrow="ALWAYS" percentWidth="25"/>
                    </columnConstraints>

                    <!-- Tarjeta: Total Productos y productos en stock bajo o critico -->
                    <VBox styleClass="md-card" spacing="8" GridPane.columnIndex="0">
                        <padding>
                            <Insets top="16" right="16" bottom="16" left="16"/>
                        </padding>
                        <HBox alignment="CENTER_LEFT">
                            <Label styleClass="md-label-large" text="Total Productos"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Region styleClass="warehouse-icon, md-icon-medium, md-icon-primary"/>
                        </HBox>
                        <Label fx:id="product_count" styleClass="md-display-small"/>
                        <HBox spacing="4" alignment="CENTER_LEFT">
                            <Label fx:id="products_on_low_or_critical_stock" styleClass="md-label-medium"/>
                            <Label styleClass="md-label-small"/>
                        </HBox>
                    </VBox>

                    <!-- Tarjeta: Stock Crítico -->
                    <VBox styleClass="md-card" spacing="8" GridPane.columnIndex="1">
                        <padding>
                            <Insets top="16" right="16" bottom="16" left="16"/>
                        </padding>
                        <HBox alignment="CENTER_LEFT">
                            <Label styleClass="md-label-large" text="Más vendido"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Region styleClass="analitycs-icon, md-icon-medium, md-icon-primary"/>
                        </HBox>
                        <Label fx:id="most_sold_product_name" styleClass="md-display-small" text="0"/>
                        <HBox spacing="4" alignment="CENTER_LEFT">
                            <Label fx:id="amount_of_sales" styleClass="md-label-medium"/>
                        </HBox>
                    </VBox>

                    <!-- Tarjeta: Stock Bajo -->
                    <VBox styleClass="md-card" spacing="8" GridPane.columnIndex="2">
                        <padding>
                            <Insets top="16" right="16" bottom="16" left="16"/>
                        </padding>
                        <HBox alignment="CENTER_LEFT">
                            <Label styleClass="md-label-large" text="Mayor recaudación"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Region styleClass="finance-icon, md-icon-medium, md-icon-primary"/>
                        </HBox>
                        <Label fx:id="highest_revenue" styleClass="md-display-small"/>
                        <HBox spacing="4" alignment="CENTER_LEFT">
                            <Label fx:id="total_revenue" styleClass="md-label-medium"/>
                        </HBox>
                    </VBox>

                    <!-- Tarjeta: Valor Total -->
                    <VBox styleClass="md-card" spacing="8" GridPane.columnIndex="3">
                        <padding>
                            <Insets top="16" right="16" bottom="16" left="16"/>
                        </padding>
                        <HBox alignment="CENTER_LEFT">
                            <Label styleClass="md-label-large" text="Valor en Stock"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Region styleClass="attach-money-icon, md-icon-medium, md-icon-primary"/>
                        </HBox>
                        <Label fx:id="total_stock_value" styleClass="md-display-small"/>
                        <HBox spacing="4" alignment="CENTER_LEFT">
                            <Label styleClass="md-label-medium"/>
                            <Label fx:id="total_stock_units" styleClass="md-label-small"/>
                        </HBox>
                    </VBox>
                </GridPane>

                <!-- Sección de Filtros -->
                <VBox spacing="12">
                    <Label styleClass="md-title-medium" text="Filtros de Búsqueda"/>

                    <VBox styleClass="md-card" spacing="16">
                        <padding>
                            <Insets top="16" right="16" bottom="16" left="16"/>
                        </padding>
                        <HBox spacing="16">
                            <!-- Buscador -->
                            <VBox spacing="4" HBox.hgrow="ALWAYS">
                                <Label styleClass="md-label-medium" text="Buscar producto"/>
                                <TextField fx:id="product_search_field" styleClass="md-text-field"
                                           maxWidth="Infinity"/>
                            </VBox>

                            <!-- Filtro por Categoría -->
                            <VBox spacing="4" HBox.hgrow="ALWAYS">
                                <Label styleClass="md-label-medium" text="Categoría"/>
                                <ComboBox fx:id="product_category_selector" styleClass="md-combo-box"
                                          maxWidth="Infinity"/>
                            </VBox>

                            <!-- Filtro por Estado de Stock -->
                            <VBox spacing="4" HBox.hgrow="ALWAYS">
                                <Label styleClass="md-label-medium" text="Estado de Stock"/>
                                <ComboBox fx:id="product_stock_status_selector" styleClass="md-combo-box"
                                          maxWidth="Infinity"/>
                            </VBox>

                            <!-- Botones de Acción -->
                            <VBox spacing="4" alignment="BOTTOM_LEFT">
                                <Label styleClass="md-label-medium" text="Acciones"/>
                                <HBox spacing="8" alignment="CENTER_LEFT">
                                    <MFXButton fx:id="clean_filters_button" styleClass="md-button-outlined"
                                               text="Limpiar"/>
                                    <MFXButton fx:id="create_product_button" styleClass="md-button-filled"
                                               text="+ Nuevo Producto"/>
                                </HBox>
                            </VBox>
                        </HBox>
                    </VBox>
                </VBox>

                <!-- Lista de Productos -->
                <VBox spacing="12">
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <Label styleClass="md-title-medium" text="Inventario de Productos"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="products_found_count" styleClass="md-body-small"/>
                    </HBox>

                    <VBox fx:id="product_list_vbox" styleClass="md-card">
                        <padding>
                            <Insets top="8" right="16" bottom="8" left="16"/>
                        </padding>
                    </VBox>
                </VBox>

            </VBox>
        </ScrollPane>
    </VBox>
</AnchorPane>
