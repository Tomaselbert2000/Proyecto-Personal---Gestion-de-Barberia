<?xml version="1.0" encoding="UTF-8"?>

<?import io.github.palexdev.materialfx.controls.MFXButton?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<AnchorPane xmlns:fx="http://javafx.com/fxml/1"
            fx:id="anchorPane"
            xmlns="http://javafx.com/javafx/17.0.12"
            fx:controller="com.presentation.controller.sale.SalesViewController">

    <VBox
            AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0"
            AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">

        <!-- Header del Panel -->
        <HBox alignment="CENTER_LEFT">
            <padding>
                <Insets top="16" right="24" bottom="16" left="24"/>
            </padding>
            <VBox spacing="2">
                <Label styleClass="md-headline-medium" text="Gestión de Ventas"/>
                <Label styleClass="md-body-large" text="Administra y registra las ventas de tu barbería"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
        </HBox>

        <!-- Contenido Principal -->
        <ScrollPane fitToHeight="true" fitToWidth="true"
                    style="-fx-background-color: transparent; -fx-background: transparent;"
                    VBox.vgrow="ALWAYS">
            <VBox spacing="24">
                <padding>
                    <Insets top="20" right="24" bottom="24" left="24"/>
                </padding>

                <!-- Tarjetas de Estadísticas -->
                <GridPane hgap="16" vgap="16">
                    <columnConstraints>
                        <ColumnConstraints hgrow="ALWAYS" percentWidth="25"/>
                        <ColumnConstraints hgrow="ALWAYS" percentWidth="25"/>
                        <ColumnConstraints hgrow="ALWAYS" percentWidth="25"/>
                        <ColumnConstraints hgrow="ALWAYS" percentWidth="25"/>
                    </columnConstraints>

                    <!-- Tarjeta: Ingresos del Mes -->
                    <VBox styleClass="md-card" spacing="8" GridPane.columnIndex="0">
                        <padding>
                            <Insets top="16" right="16" bottom="16" left="16"/>
                        </padding>
                        <HBox alignment="CENTER_LEFT">
                            <Label styleClass="md-label-large" text="Ingresos del Mes"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Region styleClass="attach-money-icon, md-icon-medium, md-icon-primary"/>
                        </HBox>
                        <Label fx:id="monthtlyIncome" styleClass="md-display-small"/>
                        <HBox spacing="4" alignment="CENTER_LEFT">
                            <Label fx:id="incomeTrendPercentageVsLastMonth" styleClass="md-label-medium"/>
                            <Label styleClass="md-label-small" text="vs mes anterior"/>
                        </HBox>
                    </VBox>

                    <!-- Tarjeta: Ticket Promedio -->
                    <VBox styleClass="md-card" spacing="8" GridPane.columnIndex="1">
                        <padding>
                            <Insets top="16" right="16" bottom="16" left="16"/>
                        </padding>
                        <HBox alignment="CENTER_LEFT">
                            <Label styleClass="md-label-large" text="Ticket Promedio"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Region styleClass="receipt-icon, md-icon-medium, md-icon-primary"/>
                        </HBox>
                        <Label fx:id="averageTicketTotal" styleClass="md-display-small"/>
                        <HBox spacing="4" alignment="CENTER_LEFT">
                            <Label fx:id="extraProductsSoldCount" styleClass="md-label-medium"/>
                            <Label styleClass="md-label-small" text="productos extra vendidos"/>
                        </HBox>
                    </VBox>

                    <!-- Tarjeta: Ventas Hoy -->
                    <VBox styleClass="md-card" spacing="8" GridPane.columnIndex="2">
                        <padding>
                            <Insets top="16" right="16" bottom="16" left="16"/>
                        </padding>
                        <HBox alignment="CENTER_LEFT">
                            <Label styleClass="md-label-large" text="Ventas Hoy"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Region styleClass="storefront-icon, md-icon-medium, md-icon-primary"/>
                        </HBox>
                        <Label fx:id="salesTodayCount" styleClass="md-display-small"/>
                        <HBox spacing="4" alignment="CENTER_LEFT">
                            <Label fx:id="mostPopularBarberService" styleClass="md-label-medium"/>
                            <Label styleClass="md-label-small" text="servicio más popular"/>
                        </HBox>
                    </VBox>

                    <!-- Tarjeta: Ingresos por Productos -->
                    <VBox styleClass="md-card" spacing="8" GridPane.columnIndex="3">
                        <padding>
                            <Insets top="16" right="16" bottom="16" left="16"/>
                        </padding>
                        <HBox alignment="CENTER_LEFT">
                            <Label styleClass="md-label-large" text="Ingresos por Productos"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Region styleClass="finance-icon, md-icon-medium, md-icon-primary"/>
                        </HBox>
                        <Label fx:id="productsIncome" styleClass="md-display-small"/>
                        <HBox spacing="4" alignment="CENTER_LEFT">
                            <Label fx:id="mostSoldProduct" styleClass="md-label-medium"/>
                            <Label styleClass="md-label-small" text="más vendido"/>
                        </HBox>
                    </VBox>
                </GridPane>

                <!-- Sección de Filtros -->
                <VBox spacing="12">
                    <Label styleClass="md-title-medium" text="Filtros de Búsqueda"/>

                    <VBox styleClass="md-card" spacing="16">
                        <padding>
                            <Insets top="16" right="16" bottom="16" left="16"/>
                        </padding>

                        <!-- Fila 1: Fecha y Rango de Precios -->
                        <HBox spacing="16">
                            <VBox spacing="4" HBox.hgrow="ALWAYS">
                                <Label styleClass="md-label-medium" text="Fecha"/>
                                <DatePicker fx:id="saleDateFilter"
                                            promptText="Seleccionar fecha"
                                            maxWidth="Infinity"
                                            styleClass="md-date-picker"/>
                            </VBox>
                            <VBox spacing="4" HBox.hgrow="ALWAYS">
                                <Label styleClass="md-label-medium" text="Precio Mínimo"/>
                                <TextField fx:id="minPriceTextfield"
                                           promptText="0.00"
                                           maxWidth="Infinity"
                                           styleClass="md-text-field"/>
                            </VBox>
                            <VBox spacing="4" HBox.hgrow="ALWAYS">
                                <Label styleClass="md-label-medium" text="Precio Máximo"/>
                                <TextField fx:id="maxPriceTextfield"
                                           promptText="0.00"
                                           maxWidth="Infinity"
                                           styleClass="md-text-field"/>
                            </VBox>
                        </HBox>

                        <!-- Fila 2: Composición de Venta y Selecciones -->
                        <HBox spacing="16">
                            <VBox spacing="4" HBox.hgrow="ALWAYS">
                                <Label styleClass="md-label-medium" text="Empleado"/>
                                <ComboBox fx:id="employeeFilter"
                                          promptText="Todos los empleados"
                                          maxWidth="Infinity"
                                          styleClass="md-combo-box"/>
                            </VBox>
                            <VBox spacing="4" HBox.hgrow="ALWAYS">
                                <Label styleClass="md-label-medium" text="Método de Pago"/>
                                <ComboBox fx:id="paymentMethodFilter"
                                          promptText="Todos los métodos"
                                          maxWidth="Infinity"
                                          styleClass="md-combo-box"/>
                            </VBox>
                            <VBox spacing="4" HBox.hgrow="ALWAYS">
                                <Label styleClass="md-label-medium" text="Composición"/>
                                <ComboBox fx:id="saleCompositionFilter"
                                          maxWidth="Infinity"
                                          styleClass="md-combo-box"/>
                            </VBox>
                        </HBox>

                        <!-- Fila 3: Acciones Rápidas -->
                        <HBox alignment="CENTER_RIGHT" spacing="8">
                            <Region HBox.hgrow="ALWAYS"/>
                            <MFXButton fx:id="cleanFilterButton" styleClass="md-button-outlined"
                                       text="Limpiar"/>
                            <MFXButton fx:id="registerNewSale" styleClass="md-button-filled"
                                       text="+ Nueva Venta"/>
                        </HBox>
                    </VBox>
                </VBox>

                <!-- Lista de Ventas -->
                <VBox spacing="12">
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <Label styleClass="md-title-medium" text="Ventas Registradas"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="totalSalesCount" styleClass="md-body-small"/>
                    </HBox>

                    <VBox fx:id="saleListContainer" styleClass="md-card">
                        <padding>
                            <Insets top="8" right="16" bottom="8" left="16"/>
                        </padding>
                    </VBox>
                </VBox>

            </VBox>
        </ScrollPane>
    </VBox>
</AnchorPane>
