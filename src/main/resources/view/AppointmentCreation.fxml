<?xml version="1.0" encoding="UTF-8"?>

<?import io.github.palexdev.materialfx.controls.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<AnchorPane xmlns:fx="http://javafx.com/fxml/1"
            xmlns="http://javafx.com/javafx/17.0.12"
            fx:id="anchorPane"
            fx:controller="com.presentation.controller.appointment.AppointmentCreationController">

    <VBox
            AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0"
            AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">

        <!-- Header del Panel -->
        <HBox alignment="CENTER_LEFT" spacing="12">
            <padding>
                <Insets top="20" right="24" bottom="12" left="24"/>
            </padding>
            <MFXButton fx:id="backButton" styleClass="md-button-outlined" text="Volver">
                <graphic>
                    <Region styleClass="arrow-up-circle-icon, md-icon-small"/>
                </graphic>
            </MFXButton>
            <VBox spacing="2">
                <Label styleClass="md-headline-medium" text="Nuevo Turno"/>
                <Label styleClass="md-body-large" text="Registra un nuevo turno en el sistema"/>
            </VBox>
        </HBox>

        <!-- Contenido Principal -->
        <ScrollPane fitToHeight="true" fitToWidth="true"
                    style="-fx-background-color: transparent; -fx-background: transparent;"
                    VBox.vgrow="ALWAYS">
            <VBox spacing="24">
                <padding>
                    <Insets top="16" right="24" bottom="24" left="24"/>
                </padding>

                <!-- Tarjeta de Cliente -->
                <VBox styleClass="md-card" spacing="16">
                    <padding>
                        <Insets top="16" right="16" bottom="16" left="16"/>
                    </padding>
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <Region styleClass="person-1-icon, md-icon-medium, md-icon-primary"/>
                        <Label styleClass="md-title-medium" text="Datos del Cliente"/>
                    </HBox>

                    <GridPane hgap="16" vgap="16">
                        <columnConstraints>
                            <ColumnConstraints hgrow="ALWAYS" percentWidth="70"/>
                            <ColumnConstraints hgrow="ALWAYS" percentWidth="30"/>
                        </columnConstraints>

                        <!-- Client Search -->
                        <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="0">
                            <HBox spacing="2">
                                <Label styleClass="md-label-medium" text="Buscar Cliente"/>
                                <Label styleClass="md-label-medium, md-input-error" text="*"/>
                            </HBox>
                            <TextField fx:id="clientSearchField" styleClass="md-text-field" maxWidth="Infinity"
                                       promptText="Escribí nombre o DNI del cliente"/>
                        </VBox>

                        <!-- New Client Button -->
                        <VBox spacing="4" GridPane.columnIndex="1" GridPane.rowIndex="0">
                            <Label styleClass="md-label-medium" text="¿Cliente nuevo?"/>
                            <MFXButton fx:id="createClientButton"
                                       styleClass="md-button-tonal" text="+ Nuevo Cliente"/>
                        </VBox>
                    </GridPane>

                    <MFXListView fx:id="clientResultList" minHeight="150.0" prefHeight="250.0" maxWidth="Infinity"
                                 visible="false"/>

                    <!-- Selected Client Info -->
                    <VBox fx:id="selectedClientCardVbox" styleClass="md-list-item" visible="false">
                        <padding>
                            <Insets top="12" right="16" bottom="12" left="16"/>
                        </padding>
                        <HBox spacing="12" alignment="CENTER_LEFT">
                            <VBox alignment="CENTER" minWidth="40.0" minHeight="40.0"
                                  styleClass="md-card-filled">
                                <Label fx:id="clientInitials" styleClass="md-label-large"/>
                            </VBox>
                            <VBox spacing="2" HBox.hgrow="ALWAYS">
                                <Label fx:id="clientName" styleClass="md-list-item-headline"/>
                                <Label fx:id="nationalIdCardNumber" styleClass="md-list-item-supporting-text"/>
                            </VBox>
                            <MFXButton fx:id="changeClientButton" styleClass="md-button-outlined" text="Cambiar"/>
                        </HBox>
                    </VBox>
                </VBox>

                <!-- Tarjeta de Servicio y Empleado -->
                <VBox styleClass="md-card" spacing="16">
                    <padding>
                        <Insets top="16" right="16" bottom="16" left="16"/>
                    </padding>
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <Region styleClass="work-icon, md-icon-medium, md-icon-primary"/>
                        <Label styleClass="md-title-medium" text="Servicio y Profesional"/>
                    </HBox>

                    <GridPane hgap="16" vgap="16">
                        <columnConstraints>
                            <ColumnConstraints hgrow="ALWAYS" percentWidth="50"/>
                            <ColumnConstraints hgrow="ALWAYS" percentWidth="50"/>
                        </columnConstraints>

                        <!-- Service Selection -->
                        <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="0">
                            <HBox spacing="2">
                                <Label styleClass="md-label-medium" text="Servicio"/>
                                <Label styleClass="md-label-medium, md-input-error" text="*"/>
                            </HBox>
                            <ComboBox fx:id="barberServiceSelector" styleClass="md-combo-box" maxWidth="Infinity"
                                      promptText="Seleccioná un servicio"/>
                        </VBox>

                        <!-- Employee Selection -->
                        <VBox spacing="4" GridPane.columnIndex="1" GridPane.rowIndex="0">
                            <HBox spacing="2">
                                <Label styleClass="md-label-medium" text="Empleado asignado"/>
                                <Label styleClass="md-label-medium, md-input-error" text="*"/>
                            </HBox>
                            <ComboBox fx:id="employeeSelector" styleClass="md-combo-box" maxWidth="Infinity"
                                      promptText="Seleccioná un profesional"/>
                        </VBox>
                    </GridPane>

                    <!-- Service Price Info -->
                    <VBox fx:id="serviceSelectionContainer" spacing="4" visible="false">
                        <HBox spacing="8" alignment="CENTER_LEFT">
                            <Region styleClass="money-bag-icon, md-icon-small, md-icon-primary"/>
                            <Label styleClass="md-label-medium" text="Precio: "/>
                            <Label fx:id="servicePrice" styleClass="md-title-medium"/>
                        </HBox>
                    </VBox>
                </VBox>

                <!-- Tarjeta de Fecha y Hora -->
                <VBox styleClass="md-card" spacing="16">
                    <padding>
                        <Insets top="16" right="16" bottom="16" left="16"/>
                    </padding>
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <Region styleClass="calendar-icon, md-icon-medium, md-icon-primary"/>
                        <Label styleClass="md-title-medium" text="Fecha y Hora"/>
                    </HBox>

                    <GridPane hgap="16" vgap="16">
                        <columnConstraints>
                            <ColumnConstraints hgrow="ALWAYS" percentWidth="40"/>
                            <ColumnConstraints hgrow="ALWAYS" percentWidth="25"/>
                            <ColumnConstraints hgrow="ALWAYS" percentWidth="15"/>
                            <ColumnConstraints hgrow="ALWAYS" percentWidth="20"/>
                        </columnConstraints>

                        <!-- Start Date -->
                        <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="0">
                            <HBox spacing="2">
                                <Label styleClass="md-label-medium" text="Fecha de Inicio"/>
                                <Label styleClass="md-label-medium, md-input-error" text="*"/>
                            </HBox>
                            <DatePicker fx:id="dateSelector" styleClass="md-date-picker" maxWidth="Infinity"
                                        promptText="Seleccioná una fecha"/>
                        </VBox>

                        <!-- Start Time -->
                        <VBox spacing="4" GridPane.columnIndex="1" GridPane.rowIndex="0">
                            <HBox spacing="2">
                                <Label styleClass="md-label-medium" text="Hora de Inicio"/>
                                <Label styleClass="md-label-medium, md-input-error" text="*"/>
                            </HBox>
                            <ComboBox fx:id="hourSelector" styleClass="md-combo-box" maxWidth="Infinity"
                                      promptText="Hora"/>
                        </VBox>

                        <!-- Start Minutes -->
                        <VBox spacing="4" GridPane.columnIndex="2" GridPane.rowIndex="0">
                            <Label styleClass="md-label-medium" text="Minutos"/>
                            <ComboBox fx:id="minuteSelector" styleClass="md-combo-box" maxWidth="Infinity"
                                      promptText="Min"/>
                        </VBox>

                        <!-- Notes -->
                        <VBox spacing="4" GridPane.columnIndex="0" GridPane.columnSpan="4" GridPane.rowIndex="1">
                            <Label styleClass="md-label-medium" text="Notas (opcional)"/>
                            <TextField fx:id="appointmentNotes" styleClass="md-text-field"
                                       maxWidth="Infinity"
                                       promptText="Observaciones adicionales del turno"/>
                        </VBox>
                    </GridPane>
                </VBox>

                <!-- Tarjeta de Resumen -->
                <VBox fx:id="summaryCardVbox" styleClass="md-card" spacing="16" visible="false">
                    <padding>
                        <Insets top="16" right="16" bottom="16" left="16"/>
                    </padding>
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <Region styleClass="info-icon, md-icon-medium, md-icon-primary"/>
                        <Label styleClass="md-title-medium" text="Resumen del Turno"/>
                    </HBox>

                    <VBox spacing="8">
                        <HBox spacing="4">
                            <Label styleClass="md-list-item-supporting-text" text="Cliente:"/>
                            <Label fx:id="summaryClient" styleClass="md-list-item-headline"/>
                        </HBox>
                        <HBox spacing="4">
                            <Label styleClass="md-list-item-supporting-text" text="Servicio:"/>
                            <Label fx:id="summaryService" styleClass="md-list-item-headline"/>
                        </HBox>
                        <HBox spacing="4">
                            <Label styleClass="md-list-item-supporting-text" text="Profesional:"/>
                            <Label fx:id="summaryEmployee" styleClass="md-list-item-headline"/>
                        </HBox>
                        <HBox spacing="4">
                            <Label styleClass="md-list-item-supporting-text" text="Fecha y Hora:"/>
                            <Label fx:id="summaryDatetime" styleClass="md-list-item-headline"/>
                        </HBox>
                        <HBox spacing="4">
                            <Label styleClass="md-list-item-supporting-text" text="Precio Total:"/>
                            <Label fx:id="summaryPrice" styleClass="md-list-item-headline"/>
                        </HBox>
                    </VBox>
                </VBox>

                <!-- Botones de Acción -->
                <HBox spacing="8" alignment="CENTER_RIGHT">
                    <MFXButton fx:id="resetFormButton" styleClass="md-button-outlined" text="Limpiar datos"/>
                    <MFXButton fx:id="saveButton" styleClass="md-button-filled" text="Crear Turno"/>
                </HBox>

            </VBox>
        </ScrollPane>
    </VBox>
</AnchorPane>
