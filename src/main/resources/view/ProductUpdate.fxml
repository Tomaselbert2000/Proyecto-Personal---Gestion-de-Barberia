<?xml version="1.0" encoding="UTF-8"?>

<?import io.github.palexdev.materialfx.controls.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<AnchorPane xmlns:fx="http://javafx.com/fxml/1"
            fx:id="anchor_pane"
            xmlns="http://javafx.com/javafx/25"
            fx:controller="com.launcher.controller.implementation.product.ProductEditionController">

    <VBox
            AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0"
            AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">

        <!-- Header del Panel -->
        <HBox alignment="CENTER_LEFT" spacing="12">
            <padding>
                <Insets top="20" right="24" bottom="12" left="24"/>
            </padding>
            <MFXButton fx:id="back_button" styleClass="md-button-outlined" text="Volver">
                <graphic>
                    <Region styleClass="arrow-up-circle-icon, md-icon-small"/>
                </graphic>
            </MFXButton>
            <VBox spacing="2">
                <Label styleClass="md-headline-medium" text="Editar Producto"/>
                <Label styleClass="md-body-large" text="Actualiza los datos del producto seleccionado"/>
            </VBox>
        </HBox>

        <!-- Contenido Principal -->
        <ScrollPane fitToHeight="true" fitToWidth="true"
                    style="-fx-background-color: transparent; -fx-background: transparent;"
                    VBox.vgrow="ALWAYS">
            <VBox spacing="24">
                <padding>
                    <Insets top="16" right="24" bottom="24" left="24"/>
                </padding>

                <!-- 1. INFORMACIÓN GENERAL DEL PRODUCTO -->
                <VBox styleClass="md-card" spacing="16">
                    <padding>
                        <Insets top="16" right="16" bottom="16" left="16"/>
                    </padding>

                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <Region styleClass="info-icon, md-icon-medium, md-icon-primary"/>
                        <Label styleClass="md-title-medium" text="Información General"/>
                    </HBox>

                    <GridPane hgap="16" vgap="16">
                        <columnConstraints>
                            <ColumnConstraints hgrow="ALWAYS" percentWidth="50"/>
                            <ColumnConstraints hgrow="ALWAYS" percentWidth="50"/>
                        </columnConstraints>

                        <!-- Nombre del Producto -->
                        <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="0">
                            <HBox spacing="2">
                                <Label styleClass="md-label-medium" text="Nombre del Producto"/>
                                <Label styleClass="md-label-medium, md-input-error" text="*"/>
                            </HBox>
                            <TextField fx:id="name" styleClass="md-text-field" maxWidth="Infinity"
                                       promptText="Ej. Shampoo Matizador 250ml"/>
                        </VBox>

                        <!-- Categoría -->
                        <VBox spacing="4" GridPane.columnIndex="1" GridPane.rowIndex="0">
                            <HBox spacing="2">
                                <Label styleClass="md-label-medium" text="Categoría"/>
                                <Label styleClass="md-label-medium, md-input-error" text="*"/>
                            </HBox>
                            <ComboBox fx:id="category" styleClass="md-combo-box" maxWidth="Infinity"
                                      promptText="Seleccionar categoría"/>
                        </VBox>

                        <!-- Descripción -->
                        <VBox spacing="4" GridPane.columnIndex="0" GridPane.columnSpan="2"
                              GridPane.rowIndex="1">
                            <Label styleClass="md-label-medium" text="Descripción"/>
                            <TextField fx:id="optional_description" styleClass="md-text-field"
                                       maxWidth="Infinity"
                                       promptText="Detalles sobre el uso, fragancia o componentes..."/>
                        </VBox>

                        <!-- Marca -->
                        <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="2">
                            <Label styleClass="md-label-medium" text="Marca"/>
                            <TextField fx:id="brand_name" styleClass="md-text-field" maxWidth="Infinity"
                                       promptText="Ej. L'Oréal, Sir Fausto"/>
                        </VBox>

                        <!-- Presentación -->
                        <HBox spacing="8" GridPane.columnIndex="1" GridPane.rowIndex="2">
                            <VBox spacing="4" HBox.hgrow="ALWAYS">
                                <Label styleClass="md-label-medium" text="Presentación"/>
                                <TextField fx:id="presentation_size" styleClass="md-text-field"
                                           maxWidth="Infinity"
                                           promptText="Ej. 250"/>
                            </VBox>
                            <VBox spacing="4" prefWidth="120.0">
                                <Label styleClass="md-label-medium" text="Unidad"/>
                                <ComboBox fx:id="presentation_unit" styleClass="md-combo-box" maxWidth="Infinity"
                                          promptText="ml"/>
                            </VBox>
                        </HBox>
                    </GridPane>
                </VBox>

                <!-- 2. PRECIOS Y COSTOS -->
                <VBox styleClass="md-card" spacing="16">
                    <padding>
                        <Insets top="16" right="16" bottom="16" left="16"/>
                    </padding>

                    <HBox alignment="CENTER_LEFT" spacing="8">
                        <Region styleClass="money-bag-icon, md-icon-medium, md-icon-primary"/>
                        <Label styleClass="md-title-medium" text="Precios y Costos"/>
                    </HBox>

                    <GridPane hgap="16" vgap="16">
                        <columnConstraints>
                            <ColumnConstraints hgrow="ALWAYS" percentWidth="33"/>
                            <ColumnConstraints hgrow="ALWAYS" percentWidth="33"/>
                            <ColumnConstraints hgrow="ALWAYS" percentWidth="33"/>
                        </columnConstraints>

                        <!-- Costo de Compra -->
                        <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="0">
                            <HBox spacing="2">
                                <Label styleClass="md-label-medium" text="Costo de Compra ($)"/>
                                <Label styleClass="md-label-medium, md-input-error" text="*"/>
                            </HBox>
                            <TextField fx:id="product_cost" styleClass="md-text-field" maxWidth="Infinity"
                                       promptText="0.00"/>
                        </VBox>

                        <!-- Precio de Venta -->
                        <VBox spacing="4" GridPane.columnIndex="1" GridPane.rowIndex="0">
                            <HBox spacing="2">
                                <Label styleClass="md-label-medium" text="Precio de Venta ($)"/>
                                <Label styleClass="md-label-medium, md-input-error" text="*"/>
                            </HBox>
                            <TextField fx:id="current_price" styleClass="md-text-field" maxWidth="Infinity"
                                       promptText="0.00"/>
                        </VBox>

                        <!-- Margen de Ganancia (Cálculo Destacado) -->
                        <VBox spacing="4" GridPane.columnIndex="2" GridPane.rowIndex="0">
                            <Label styleClass="md-label-medium" text="Margen de Ganancia"/>
                            <HBox alignment="CENTER_LEFT" styleClass="md-card-filled" prefHeight="38.0">
                                <padding>
                                    <Insets left="12" right="12"/>
                                </padding>
                                <Label fx:id="profit_margin_value" styleClass="md-title-medium" text="0%"/>
                            </HBox>
                        </VBox>

                        <!-- Precio Mayoreo -->
                        <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="1">
                            <Label styleClass="md-label-medium" text="Precio de venta por mayor ($)"/>
                            <TextField fx:id="product_wholesale_price" styleClass="md-text-field" maxWidth="Infinity"
                                       promptText="0.00"/>
                        </VBox>

                        <!-- Precio Mínimo -->
                        <VBox spacing="4" GridPane.columnIndex="1" GridPane.rowIndex="1">
                            <Label styleClass="md-label-medium" text="Precio de venta mínimo ($)"/>
                            <TextField fx:id="min_price" styleClass="md-text-field" maxWidth="Infinity"
                                       promptText="0.00"/>
                        </VBox>

                        <!-- Descuento Máximo -->
                        <VBox spacing="4" GridPane.columnIndex="2" GridPane.rowIndex="1">
                            <Label styleClass="md-label-medium" text="Descuento Máximo (%)"/>
                            <TextField fx:id="max_discount_percentage" styleClass="md-text-field" maxWidth="Infinity"
                                       promptText="0%"/>
                        </VBox>
                    </GridPane>
                </VBox>

                <!-- 3. INVENTARIO E IMAGEN (FILA COMPARTIDA) -->
                <GridPane hgap="16" vgap="16">
                    <columnConstraints>
                        <ColumnConstraints hgrow="ALWAYS" percentWidth="50"/>
                        <ColumnConstraints hgrow="ALWAYS" percentWidth="50"/>
                    </columnConstraints>

                    <!-- Tarjeta de Stock e Inventario -->
                    <VBox styleClass="md-card" spacing="16" GridPane.columnIndex="0">
                        <padding>
                            <Insets top="16" right="16" bottom="16" left="16"/>
                        </padding>

                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <Region styleClass="warehouse-icon, md-icon-medium, md-icon-primary"/>
                            <Label styleClass="md-title-medium" text="Stock e Inventario"/>
                        </HBox>

                        <GridPane hgap="16" vgap="16">
                            <columnConstraints>
                                <ColumnConstraints hgrow="ALWAYS" percentWidth="50"/>
                                <ColumnConstraints hgrow="ALWAYS" percentWidth="50"/>
                            </columnConstraints>

                            <!-- Stock Actual -->
                            <VBox spacing="4" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                <Label styleClass="md-label-medium" text="Stock Actual"/>
                                <TextField fx:id="current_stock_level" editable="false"
                                           styleClass="md-text-field" maxWidth="Infinity"
                                           promptText="Se calcula automáticamente"/>
                            </VBox>

                            <!-- Stock Mínimo -->
                            <VBox spacing="4" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                <HBox spacing="2">
                                    <Label styleClass="md-label-medium" text="Stock Mínimo"/>
                                    <Label styleClass="md-label-medium, md-input-error" text="*"/>
                                </HBox>
                                <TextField fx:id="safety_stock_level" styleClass="md-text-field" maxWidth="Infinity"
                                           promptText="5"/>
                            </VBox>
                        </GridPane>
                    </VBox>

                    <!-- Tarjeta de Imagen del Producto -->
                    <VBox styleClass="md-card" spacing="16" GridPane.columnIndex="1">
                        <padding>
                            <Insets top="16" right="16" bottom="16" left="16"/>
                        </padding>

                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <Region styleClass="box-icon, md-icon-medium, md-icon-primary"/>
                            <Label styleClass="md-title-medium" text="Imagen del Producto"/>
                        </HBox>

                        <HBox spacing="16" alignment="CENTER_LEFT">
                            <StackPane styleClass="md-card-filled" prefWidth="90.0" prefHeight="90.0">
                                <ImageView fx:id="product_image_preview" fitHeight="80.0" fitWidth="80.0"
                                           pickOnBounds="true" preserveRatio="true"/>
                            </StackPane>

                            <VBox spacing="8" alignment="CENTER_LEFT">
                                <MFXButton fx:id="select_image_button" styleClass="md-button-outlined"
                                           text="Seleccionar Imagen"/>
                                <MFXButton fx:id="remove_image_button" styleClass="md-button-text"
                                           text="Eliminar Imagen"/>
                                <Label styleClass="md-body-small" text="Formatos permitidos: JPG, PNG"/>
                            </VBox>
                        </HBox>
                    </VBox>
                </GridPane>

                <!-- 4. BARRA DE ACCIONES PRINCIPAL -->
                <HBox spacing="8" alignment="CENTER_RIGHT">
                    <MFXButton fx:id="reset_button" styleClass="md-button-outlined" text="Restaurar valores"/>
                    <MFXButton fx:id="save_button" styleClass="md-button-filled" text="Actualizar datos">
                        <graphic>
                            <Region styleClass="done-all-icon, md-icon-small, md-icon-on-surface"/>
                        </graphic>
                    </MFXButton>
                </HBox>

            </VBox>
        </ScrollPane>
    </VBox>
</AnchorPane>
