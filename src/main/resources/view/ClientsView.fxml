<?xml version="1.0" encoding="UTF-8"?>

<?import io.github.palexdev.materialfx.controls.MFXButton?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<AnchorPane xmlns:fx="http://javafx.com/fxml/1"
            fx:id="anchorPane"
            xmlns="http://javafx.com/javafx/17.0.12"
            fx:controller="com.presentation.controller.client.ClientViewController">

    <VBox
            AnchorPane.topAnchor="0.0" AnchorPane.bottomAnchor="0.0"
            AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0">

        <!-- Header del Panel -->
        <HBox alignment="CENTER_LEFT">
            <padding>
                <Insets top="16" right="24" bottom="16" left="24"/>
            </padding>
            <VBox spacing="2">
                <Label styleClass="md-headline-medium" text="Clientes"/>
                <Label styleClass="md-body-large" text="Administra tu cartera de clientes"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
        </HBox>

        <!-- Contenido Principal -->
        <ScrollPane fitToHeight="true" fitToWidth="true"
                    style="-fx-background-color: transparent; -fx-background: transparent;"
                    VBox.vgrow="ALWAYS">
            <VBox spacing="24">
                <padding>
                    <Insets top="20" right="24" bottom="24" left="24"/>
                </padding>

                <!-- Tarjetas de Estadísticas -->
                <GridPane hgap="16" vgap="16">
                    <columnConstraints>
                        <ColumnConstraints hgrow="ALWAYS" percentWidth="25"/>
                        <ColumnConstraints hgrow="ALWAYS" percentWidth="25"/>
                        <ColumnConstraints hgrow="ALWAYS" percentWidth="25"/>
                        <ColumnConstraints hgrow="ALWAYS" percentWidth="25"/>
                    </columnConstraints>

                    <!-- Tarjeta: Total Clientes -->
                    <VBox styleClass="md-card" spacing="8" GridPane.columnIndex="0">
                        <padding>
                            <Insets top="16" right="16" bottom="16" left="16"/>
                        </padding>
                        <HBox alignment="CENTER_LEFT">
                            <Label styleClass="md-label-large" text="Total Clientes"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Region styleClass="person-1-icon, md-icon-medium, md-icon-primary"/>
                        </HBox>
                        <Label fx:id="totalClientsCount" styleClass="md-display-small"/>
                        <HBox spacing="4" alignment="CENTER_LEFT">
                            <Label fx:id="newClientsThisMonth" styleClass="md-label-medium"/>
                            <Label styleClass="md-label-small" text="nuevos este mes"/>
                        </HBox>
                    </VBox>

                    <!-- Tarjeta: Con Teléfono -->
                    <VBox styleClass="md-card" spacing="8" GridPane.columnIndex="1">
                        <padding>
                            <Insets top="16" right="16" bottom="16" left="16"/>
                        </padding>
                        <HBox alignment="CENTER_LEFT">
                            <Label styleClass="md-label-large" text="Con Teléfono"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Region styleClass="contact-phone-icon, md-icon-medium, md-icon-primary"/>
                        </HBox>
                        <Label fx:id="clientsWithAtLeastOnePhoneNumber" styleClass="md-display-small"/>
                        <HBox spacing="4" alignment="CENTER_LEFT">
                            <Label fx:id="clientsWithNoPhoneNumber" styleClass="md-label-medium"/>
                            <Label styleClass="md-label-small" text="sin teléfono"/>
                        </HBox>
                    </VBox>

                    <!-- Tarjeta: Crecimiento -->
                    <VBox styleClass="md-card" spacing="8" GridPane.columnIndex="2">
                        <padding>
                            <Insets top="16" right="16" bottom="16" left="16"/>
                        </padding>
                        <HBox alignment="CENTER_LEFT">
                            <Label styleClass="md-label-large" text="Crecimiento"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Region styleClass="timeline-icon, md-icon-medium, md-icon-primary"/>
                        </HBox>
                        <Label fx:id="newClientsVsLastMonthPercentage" styleClass="md-display-small"/>
                        <HBox spacing="4" alignment="CENTER_LEFT">
                            <Label fx:id="totalClientsRegisteredLastMonth" styleClass="md-label-medium"/>
                            <Label styleClass="md-label-small" text="mes anterior"/>
                        </HBox>
                    </VBox>

                    <!-- Tarjeta: Con Notas -->
                    <VBox styleClass="md-card" spacing="8" GridPane.columnIndex="3">
                        <padding>
                            <Insets top="16" right="16" bottom="16" left="16"/>
                        </padding>
                        <HBox alignment="CENTER_LEFT">
                            <Label styleClass="md-label-large" text="Con Notas"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Region styleClass="notes-icon, md-icon-medium, md-icon-primary"/>
                        </HBox>
                        <Label fx:id="totalClientsWithNotes" styleClass="md-display-small"/>
                        <HBox spacing="4" alignment="CENTER_LEFT">
                            <Label fx:id="clientsWithNotesPercentage" styleClass="md-label-medium"/>
                            <Label styleClass="md-label-small" text="del total"/>
                        </HBox>
                    </VBox>
                </GridPane>

                <!-- Sección de Filtros -->
                <VBox spacing="12">
                    <Label styleClass="md-title-medium" text="Filtros de Búsqueda"/>

                    <VBox styleClass="md-card" spacing="16">
                        <padding>
                            <Insets top="16" right="16" bottom="16" left="16"/>
                        </padding>
                        <HBox spacing="16">
                            <!-- Buscador -->
                            <VBox spacing="4" HBox.hgrow="ALWAYS">
                                <Label styleClass="md-label-medium" text="Buscar cliente"/>
                                <TextField fx:id="searchField" styleClass="md-text-field"
                                           maxWidth="Infinity"/>
                            </VBox>

                            <!-- Filtro por Fecha de Registro -->
                            <VBox spacing="4" HBox.hgrow="ALWAYS">
                                <Label styleClass="md-label-medium" text="Fecha de Registro"/>
                                <ComboBox fx:id="registrationDateFilter" styleClass="md-combo-box"
                                          maxWidth="Infinity"/>
                            </VBox>

                            <!-- Filtro por Teléfono -->
                            <VBox spacing="4" HBox.hgrow="ALWAYS">
                                <Label styleClass="md-label-medium" text="Teléfono"/>
                                <ComboBox fx:id="registeredPhoneFilter" styleClass="md-combo-box"
                                          maxWidth="Infinity"/>
                            </VBox>

                            <!-- Filtro por Notas -->
                            <VBox spacing="4" HBox.hgrow="ALWAYS">
                                <Label styleClass="md-label-medium" text="Notas"/>
                                <ComboBox fx:id="clientNotesFilter" styleClass="md-combo-box"
                                          maxWidth="Infinity"/>
                            </VBox>

                            <!-- Botones de Acción -->
                            <VBox spacing="4" alignment="BOTTOM_LEFT">
                                <Label styleClass="md-label-medium" text="Acciones"/>
                                <HBox spacing="8" alignment="CENTER_LEFT">
                                    <MFXButton fx:id="cleanFiltersButton" styleClass="md-button-outlined"
                                               text="Limpiar"/>
                                    <MFXButton fx:id="createClientButton" styleClass="md-button-filled"
                                               text="+ Nuevo Cliente"/>
                                </HBox>
                            </VBox>
                        </HBox>
                    </VBox>
                </VBox>

                <!-- Lista de Clientes -->
                <VBox spacing="12">
                    <HBox spacing="8" alignment="CENTER_LEFT">
                        <Label styleClass="md-title-medium" text="Clientes Registrados"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="listCount" styleClass="md-body-small"/>
                    </HBox>

                    <VBox fx:id="clientsListVBox" styleClass="md-card">
                        <padding>
                            <Insets top="8" right="16" bottom="8" left="16"/>
                        </padding>
                    </VBox>
                </VBox>

            </VBox>
        </ScrollPane>
    </VBox>
</AnchorPane>
